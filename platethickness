import numpy as np
import os

def analyze_continuous_slab_thickness(vtk_file_path, lon_step=5.0):
    if not os.path.exists(vtk_file_path):
        print(f"\n檔案不存在: {vtk_file_path}")
        return

    with open(vtk_file_path, 'r') as f:
        lines = f.readlines()

    start_idx = 0
    num_points = 0
    for i, line in enumerate(lines):
        if line.startswith("POINTS"):
            num_points = int(line.split()[1])
            start_idx = i + 1
            break

    if num_points == 0:
        print(f"\n檔案讀取失敗或無資料點: {vtk_file_path}")
        return

    points_data = []
    for i in range(start_idx, start_idx + num_points):
        if i < len(lines):
            row = lines[i].strip().split()
            if len(row) == 3:
                points_data.append([float(val) for val in row])

    points = np.array(points_data)
    x = points[:, 0]
    y = points[:, 1]
    z = points[:, 2]

    earth_radius = 6371.0

    r = np.sqrt(x**2 + y**2 + z**2)
    lat = np.arcsin(z / r) * (180.0 / np.pi)
    lon = np.arctan2(y, x) * (180.0 / np.pi)
    depth = (1.0 - r) * earth_radius

    min_lon_data = np.min(lon)
    max_lon_data = np.max(lon)

    bin_start = np.floor(min_lon_data / lon_step) * lon_step
    bin_end = np.ceil(max_lon_data / lon_step) * lon_step

    bins = np.arange(bin_start, bin_end + lon_step, lon_step)

    print(f"\n檔案: {vtk_file_path}")
    print(f"經度劃分區間: {lon_step} 度")
    print("-" * 75)

    for i in range(len(bins) - 1):
        lon_min = bins[i]
        lon_max = bins[i+1]

        mask = (lon >= lon_min) & (lon < lon_max)
        valid_depth = depth[mask]

        if len(valid_depth) > 0:
            valid_lon = lon[mask]
            valid_lat = lat[mask]

            max_depth_idx = np.argmax(valid_depth)
            max_depth = valid_depth[max_depth_idx]
            deepest_lon = valid_lon[max_depth_idx]
            deepest_lat = valid_lat[max_depth_idx]

            min_depth = np.min(valid_depth)
            thickness_variation = max_depth - min_depth

            print(f"經度 {lon_min:5.1f} ~ {lon_max:5.1f} | 最深點經緯: ({deepest_lon:6.2f}, {deepest_lat:6.2f}) | 深度: {max_depth:6.2f} km | 厚度變化: {thickness_variation:6.2f} km")

if __name__ == "__main__":
    for i in range(1, 7):
        vtk_file = f'p001.9998.{i:02d}.vtk'
        analyze_continuous_slab_thickness(vtk_file, lon_step=5.0)
